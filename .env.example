# GEMINI_API_KEY: Required for all AI routes. Set this in your hosting
# provider's environment variables — never commit the real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed app (used for OAuth callbacks).
APP_URL="MY_APP_URL"

# PORT: Local dev port. Hosting platforms usually inject this automatically.
PORT=3000

# APP_ACCESS_KEY: Optional password for public previews/tunnels. When set,
# every route except /api/health and OAuth callbacks asks for HTTP Basic auth
# (any username, this value as the password). Leave empty for local-only use.
APP_ACCESS_KEY=""

# ── Live Insights (YouTube + TikTok official APIs) ──────────────────────────
# Create these in Google Cloud Console / TikTok for Developers, then add them
# in Render → Environment. Never commit real values to GitHub.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Long random text (32+ characters). Encrypts OAuth tokens inside HttpOnly
# cookies. Changing it forces both channels to reconnect.
INTEGRATION_SECRET=""
